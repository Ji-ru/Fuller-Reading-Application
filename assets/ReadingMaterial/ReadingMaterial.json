  "Passages": [
    {
      "title": "Ang Ama",
      "author": "",
      "category": "beginner",
      "letter": "Ang",
      "aralin": 4,
      "image": "",
      "text": "Ang ama, aasa.\nSasama sa masa.\nSasama sa masa ang ama.\nSasama sa masa ang mama."
    },
    {
      "title": "Sa Misa",
      "author": "",
      "category": "beginner",
      "letter": "I",
      "aralin": 5,
      "image": "",
      "text": "Iisa ang misa.\nSasama sa misa si Sisa.\nSi Mimi, sasama sa misa.\nIsama sa misa si Ami."
    },
    {
      "title": "Ang Amo",
      "author": "",
      "category": "beginner",
      "letter": "O",
      "aralin": 6,
      "image": "",
      "text": "Maamo ang aso.\nSi Siso ang amo.\n\"Siso, isama mo ang aso.\"\nMaamo ang aso sa amo."
    },
    {
      "title": "Maamo",
      "author": "",
      "category": "beginner",
      "letter": "Ay",
      "aralin": 7,
      "image": "",
      "text": "Si Ami ay may aso.\nSi Mimi ay may oso.\nAng aso ay maamo.\nAng oso ay maamo.\nMaamo ang aso sa oso."
    },
    {
      "title": "Mais sa Mesa",
      "author": "",
      "category": "beginner",
      "letter": "E",
      "aralin": 8,
      "image": "",
      "text": "Mama, mama\nMay mais sa mesa.\nAng mais ay isa.\nMay mais si Emi sa mesa."
    },
    {
      "title": "Usa",
      "author": "",
      "category": "beginner",
      "letter": "U",
      "aralin": 9,
      "image": "",
      "text": "May usa si ama.\nIisa ang usa.\nAng usa ay umaasa.\nAng usa ay sumasama sa ama."
    },
    {
      "title": "Bibo ang Bibe",
      "author": "",
      "category": "beginner",
      "letter": "B",
      "aralin": 10,
      "image": "",
      "text": "Emi, ang bibe mo ay babae.\nBibo ang bibe mo.\nIsasama mo ba ang bibe mo sa ibaba?"
    },
    {
      "title": "Tutubi at Tuta",
      "author": "",
      "category": "beginner",
      "letter": "T",
      "aralin": 11,
      "image": "",
      "text": "May tutubi sa mesa.\nSa ibaba, may tuta.\n\"Tito at tita,\ntumabi ang tutubi sa tuta.\""
    },
    {
      "title": "Ako ay May Keso",
      "author": "",
      "category": "beginner",
      "letter": "K",
      "aralin": 12,
      "image": "",
      "text": "Kiko, may keso ako sa mesa.\nKika, may keso ako sa kama.\nTotoo, may keso ako sa mesa\nat kama. Kay Koko ang isa."
    },
    {
      "title": "Si Lili",
      "author": "",
      "category": "beginner",
      "letter": "L",
      "aralin": 13,
      "image": "",
      "text": "Si Lili ay may laso.\nAng laso ay lila.\nAng laso ay luma.\nBaka kay lola ang laso ni Lili."
    },
    {
      "title": "Si Kuya",
      "author": "",
      "category": "beginner",
      "letter": "Y",
      "aralin": 14,
      "image": "",
      "text": "Si kuya ay masaya.\nSiya ay may yoyo.\nIto ay biyaya.\nSumama si kuya kay yaya.\nSila ay masaya."
    },
    {
      "title": "May Mga Susi",
      "author": "",
      "category": "beginner",
      "letter": "Mga",
      "aralin": 15,
      "image": "",
      "text": "May mga susi sa mesa.\nKay Lito ang mga susi sa mesa.\nAng mga susi sa kama ay kay\nYeye. Ang mga kuya ko ay may\nmga susi."
    },
    {
      "title": "Nasaan ang Unan?",
      "author": "",
      "category": "beginner",
      "letter": "N",
      "aralin": 16,
      "image": "",
      "text": "Nina, nasaan ang unan?\nAng anim na unan, nasaan?\nNina, ibalik ang mga unan sa\nkama."
    },
    {
      "title": "Ang Gansa si Gibo",
      "author": "",
      "category": "beginner",
      "letter": "G",
      "aralin": 17,
      "image": "",
      "text": "Si Gibo ay may gansa. Ang\ngansa ay si Gali. Sa ilog naliligo\nsi Gali. Si Gali ay malusog.\nKasama ni Gibo si Gali."
    },
    {
      "title": "Si Rosa R. Romero",
      "author": "",
      "category": "beginner",
      "letter": "R",
      "aralin": 18,
      "image": "",
      "text": "Si Rosa ay guro.\nGuro siya nina Remi.\nNag-aaral sila sa umaga.\nMasaya sina Remi sa guro nila."
    },
    {
      "title": "Pusa ni Pepito",
      "author": "",
      "category": "beginner",
      "letter": "P",
      "aralin": 19,
      "image": "",
