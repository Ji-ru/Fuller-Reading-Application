the drain"]},{lesson_id:3,title:"words with '-ay'",letter:"A",words:["day","bay","hay","jay","lay","may","pay","ray","say","way"],phrases:["play all day","stay away today","lay in the hay","pay to play","gray clay tray"]},{lesson_id:4,title:"words with 'ie'",letter:"E",words:["pie","tie","lie","die","field","yield","brief","chief","thief","belief"],phrases:["tie the pie","chief of the field","piece of relief","yield to belief","brief niece"]},{lesson_id:5,title:"words with 'ee'",letter:"E",words:["see","bee","fee","tee","wee","tree","free","knee","three","speed"],phrases:["see the bee","three free trees","meet my feet","need speed to feed","sweet sheet"]},{lesson_id:6,title:"words with 'ea'",letter:"E",words:["eat","meat","beat","heat","seat","feat","neat","treat","wheat","beach"],phrases:["eat the meat","teach at the beach","please speak","weak sneak","wheat treat"]},{lesson_id:7,title:"words added with 'e'",letter:"I",words:["bite","kite","site","mite","quite","white","write","hide","ride","side"],phrases:["ride the white kite","hide and slide","quite wide side","five brides glide","drive to dive"]},{lesson_id:8,title:"words ending in '-y'",letter:"I",words:["fly","sky","dry","try","cry","fry","sly","spy","shy","why"],phrases:["fly in the sky","try not to cry","shy spy","why deny","apply and supply"]},{lesson_id:9,title:"words with 'l'",letter:"I",words:["wild","mild","child","file","mile","pile","tile","while","smile","style"],phrases:["wild child","smile a while","file the tile","final mile","vital cycle"]},{lesson_id:10,title:"words with 'ie'",letter:"I",words:["pie","tie","lie","die","cried","tried","fried","dried","flies","ties"],phrases:["tie the pie","tried and cried","flies and dies","fried pies","spies lie"]},{lesson_id:11,title:"words with '-o' or '-u'",letter:"O",words:["on","off","son","won","ton","done","none","month","front","come"],phrases:["come and love","son won","some glove above","mother and brother","front of another"]},{lesson_id:12,title:"words added with 'e'",letter:"O",words:["bone","stone","cone","zone","phone","throne","alone","home","dome","Rome"],phrases:["home alone","stone throne","smoke broke the cone","hope and cope","joke on the phone"]},{lesson_id:13,title:"words with '-aw'",letter:"O",words:["saw","raw","law","draw","straw","claw","flaw","jaw","paw","thaw"],phrases:["saw the law","draw with a claw","yawn at dawn","crawl on the lawn","awful hawk"]},{lesson_id:14,title:"words with '-au'",letter:"O",words:["haul","maul","Paul","fault","vault","cause","pause","sauce","launch","haunt"],phrases:["Paul's fault","pause and haul","taught the daughter","caught in autumn","naughty author"]},{lesson_id:15,title:"words with '-oo'",letter:"O",words:["book","look","cook","hook","took","shook","foot","good","wood","hood"],phrases:["look at the book","good wood","cook shook the hook","stood on foot","could pull wool"]},{lesson_id:16,title:"words with '-o' or '-u'",letter:"A",words:["love","dove","above","glove","shove","some","come","done","none","won"],phrases:["love from above","some money honey","come up front","mother loves son","done with glove"]},{lesson_id:17,title:"words with '-ou' sounded as /aw/",letter:"A",words:["out","pout","shout","about","scout","proud","cloud","loud","found","round"],phrases:["shout out loud","proud of cloud","found round sound","count and bounce","mouse in the house"]},{lesson_id:18,title:"words with '-ow' sounded as /aw/",letter:"A",words:["cow","how","now","bow","wow","plow","brow","town","down","brown"],phrases:["cow in town","how now brown cow","flower power","down with a frown","clown with a crown"]},{lesson_id:19,title:"words with 'oy' or 'oi' sounds",letter:"O",words:["boy","toy","joy","Roy","annoy","enjoy","employ","destroy","loyal","royal"],phrases:["boy and his toy","joy to employ","boil in oil","join the coin","noise of voice"]},{lesson_id:20,title:"words with '-ew'",letter:"U",words:["new","few","dew","chew","blew","crew","drew","flew","grew","knew"],phrases:["new crew flew","chew few cashews","knew the view","threw a screw","nephew grew"]}]},{chapter_id:3,title:"Consonant Blending",lessons:[{lesson_id:1,title:"Consonant Blend 'bl'",letter:"B",words:["blue","blow","black","block","blood","blend","blink","blind","bleed","blaze"],phrases:["black and blue","blow a bubble","blind blink","blood and blade","bless and bliss"]},{lesson_id:2,title:"Consonant Blend 'br'",letter:"B",words:["brown","bring","bread","break","brick","brave","bride","brain","brush","brass"],phrases:["brown bread","brave bride","break a brick","brush and broom","bring brass"]},{lesson_id:3,title:"Consonant Blend 'gl'",letter:"G",words:["glad","glass","glue","globe","glove","glow","glide","gloom","glare","gleam"],phrases:["glad glove","glass globe","glue and glow","glide with glory","gloom and gleam"]},{lesson_id:4,title:"Consonant Blend 'gr'",letter:"G",words:["green","grass","grow","great","grape","grade","grain","grand","grasp","gray"],phrases:["green grass","grow grapes","great grade","grasp and grip","greet with grace"]},{lesson_id:5,title:"Consonant Blend 'cr'",letter:"C",words:["crab","crack","crash","cream","creek","creep","crew","crib","crown","crowd"],phrases:["crab in creek","cream and crack","crown on crew","crawl to crib","crazy craft"]},{lesson_id:6,title:"Consonant Blend 'cl'",letter:"C",words:["clap","class","clean","clock","close","cloud","clown","club","clam","clay"],phrases:["clap in class","clean clock","close the cloud","clown in club","clay and claw"]},{lesson_id:7,title:"Consonant Blend 'dr'",letter:"D",words:["draw","dream","dress","drink","drive","drop","drum","dry","drag","drain"],phrases:["draw a dream","dress and drive","drink drop","drum drill","dry and drain"]},{lesson_id:8,title:"Consonant Blend 'fl'",letter:"F",words:["flag","flat","fly","flow","flower","floor","float","flash","flame","flap"],phrases:["flag on floor","fly and float","flower flow","flash flame","flat flake"]},{lesson_id:9,title:"Consonant Blend 'fr'",letter:"